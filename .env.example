# ==================== TrendSphere Environment Variables ====================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub - only commit this .env.example file

# MongoDB Configuration
# For local development: mongodb://127.0.0.1:27017/trendsphere
# For MongoDB Atlas (cloud): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trendsphere
MONGODB_URI=mongodb://127.0.0.1:27017/trendsphere

# JWT Secret - Change this to a strong random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port
PORT=3000

# In-Memory Database Flag (for testing without MongoDB)
USE_IN_MEMORY=false

# Email Configuration (optional - for password reset features)
# For Gmail: use an App Password, not your regular password
# EMAIL_USER=yourapp@gmail.com
# EMAIL_PASS=your_gmail_app_password

# ==================== API KEYS FOR TREND DATA ====================

# Twitter/X API - Get from: https://developer.twitter.com/
# Leave empty if not using Twitter data
TWITTER_BEARER_TOKEN=

# Feature flag to enable/disable Twitter API calls
ENABLE_TWITTER=false

# Reddit API - Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=TrendSphere/1.0

# NewsAPI Key - Get from: https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# Note: Google Trends API doesn't require authentication
